{
  "name": "@mhingston5/gearbox",
  "version": "0.3.0",
  "description": "AI agent harness bootstrap for any repo",
  "type": "module",
  "bin": {
    "gearbox": "bin/gearbox.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhingston/gearbox.git"
  },
  "bugs": {
    "url": "https://github.com/mhingston/gearbox/issues"
  },
  "homepage": "https://github.com/mhingston/gearbox#readme",
  "keywords": [
    "ai",
    "agent",
    "harness",
    "copilot",
    "claude",
    "codex",
    "gemini",
    "opencode",
